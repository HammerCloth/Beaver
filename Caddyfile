# Beaver 自带的 Web 服务器：发前端静态文件，把接口转给后端。
# 只在容器内监听 :80（docker-compose 默认映射到本机 127.0.0.1:8080），不处理域名和 HTTPS。
# 要用域名访问，在前面放一个你自己的反向代理指向这个端口，见 docs/DEPLOYMENT.md。
{
  # 不申请证书，也不做 HTTP → HTTPS 跳转
  auto_https off

  servers {
    # 信任前面那层反向代理传来的 X-Forwarded-Proto / X-Forwarded-Host。
    # 否则它们会被改写成本层的 http，OAuth / MCP 元数据里的地址会变成 http://
    trusted_proxies static private_ranges
  }
}

:80 {
  log {
    output stdout
    format console
  }

  encode gzip

  handle /api/* {
    reverse_proxy backend:8080
  }

  handle /mcp {
    reverse_proxy backend:8080
  }

  handle /.well-known/oauth-protected-resource {
    reverse_proxy backend:8080
  }

  handle /.well-known/oauth-authorization-server {
    reverse_proxy backend:8080
  }

  handle /oauth/* {
    reverse_proxy backend:8080
  }

  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }
}
